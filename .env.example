# ============================================================
# ENVIRONMENT VARIABLES — salin file ini ke ".env" lalu isi nilainya.
# JANGAN commit ".env" (berisi rahasia) ke Git.
# ============================================================

# Dari Neon: Dashboard project > Connect > pilih "Pooled connection".
# Host mengandung "-pooler" — dipakai app saat runtime normal.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Dari Neon: Dashboard project > Connect > pilih "Direct connection"
# (tanpa "-pooler" di host). Dipakai HANYA untuk `prisma migrate`.
DIRECT_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# String acak untuk enkripsi sesi NextAuth. Generate dengan:
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# URL produksi nanti, mis. https://admin.okksigencart.id
# Untuk development lokal, biarkan http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# Akun OWNER pertama, dibuat oleh prisma/seed.ts
OWNER_NAME=""
OWNER_EMAIL=""
OWNER_PASSWORD=""

# Domain publik situs (tanpa trailing slash) — dipakai next-sitemap &
# metadata SEO (canonical URL, JSON-LD, Open Graph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
